# Review Copilot runs fully offline with the heuristic scorer.
# All keys are optional. Never commit real secrets.

# Optional LLM rationale refinement (OpenAI-compatible).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional Anthropic fallback if OPENAI_API_KEY is unset.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional read-only ChainPatrol enrichment.
# Request a key: org dashboard → Settings → API keys → Create Key
# Docs: https://chainpatrol.com/docs/general/api-key
# Support: engineering@chainpatrol.io
# CHAINPATROL_API_KEY=
